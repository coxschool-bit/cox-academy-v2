    "operationName": "GetMyEnrollments",
    "variables": {},
    "query": "# dataconnect/connector/operations.gql\r\n\r\n# 1. Fetch the currently logged-in user's profile and family details\r\nquery GetCurrentUser @auth(level: USER) {\r\n  user(key: { id: \"auth.uid\" }) {\r\n    id email name role gradeLevel\r\n    household { id name subscriptionTier }\r\n  }\r\n}\r\n\r\nquery GetClassDetails($classId: UUID!) @auth(level: USER) {\r\n  class(key: { id: $classId }) {\r\n    id name subject color\r\n    teacherId\r\n  }\r\n}\r\n\r\n# 2. Get all classes a student is currently enrolled in\r\nquery GetMyEnrollments($studentId: String!) @auth(level: USER) {\r\n  enrollments(where: { studentId: { eq: $studentId } }) {\r\n    class { id name subject color }\r\n  }\r\n}\r\n\r\n# 3. Get all assignments for a specific class\r\nquery GetClassAssignments($classId: UUID!) @auth(level: USER) {\r\n  assignments(where: { classId: { eq: $classId } }) {\r\n    id title instruction dueDate\r\n  }\r\n}\r\n\r\n# 4. Create a new core User record (run right after signing up)\r\nmutation CreateUser($email: String!, $name: String!, $role: String!, $householdId: UUID, $gradeLevel: String) @auth(level: USER) {\r\n  user_insert(data: { email: $email, name: $name, role: $role, householdId: $householdId, gradeLevel: $gradeLevel })\r\n}\r\n\r\n# 5. Create a new Class (Instructors only)\r\nmutation CreateClass($name: String!, $subject: String!, $color: String, $teacherId: String!) @auth(level: USER) {\r\n  class_insert(data: { name: $name, subject: $subject, color: $color, teacherId: $teacherId })\r\n}\r\n\r\n# 6. Create a new Assignment inside a Class\r\nmutation CreateAssignment($title: String!, $instruction: String, $dueDate: Date!, $classId: UUID!) @auth(level: USER) {\r\n  assignment_insert(data: { title: $title, instruction: $instruction, dueDate: $dueDate, classId: $classId })\r\n}\r\n\r\n# 7. Submit homework with a Cloud Storage attachment (Student)\r\nmutation SubmitAssignment($submissionId: UUID!, $fileUrl: String!) @auth(level: USER) {\r\n  submission_update(key: { id: $submissionId }, data: { status: \"SUBMITTED\", fileUrl: $fileUrl })\r\n}\r\n\r\n# 8. Grade a homework submission with feedback (Teacher or Parent)\r\nmutation GradeSubmission($submissionId: UUID!, $grade: String!, $feedback: String!) @auth(level: USER) {\r\n  submission_update(key: { id: $submissionId }, data: { status: \"GRADED\", grade: $grade, feedback: $feedback })\r\n}\r\n\n",
    "extensions": {}
}
